rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ─────────────────────────────────────────────────────────────
    // Hilfsfunktionen
    // ─────────────────────────────────────────────────────────────
    function signedIn() {
      return request.auth != null;
    }

    function isOwnUser(userId) {
      return signedIn() && request.auth.uid == userId;
    }

    function isAuctionSeller() {
      return signedIn() && resource.data.sellerId == request.auth.uid;
    }

    function isValidUserCreate(userId) {
      return isOwnUser(userId)
        && request.resource.data.keys().hasOnly([
          'uid', 'username', 'email', 'createdAt', 'coins'
        ])
        && request.resource.data.keys().hasAll([
          'uid', 'username', 'email', 'createdAt'
        ])
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.username is string
        && request.resource.data.username.size() >= 3
        && request.resource.data.username.size() <= 20
        && request.resource.data.email is string
        && request.resource.data.email.size() > 0
        && request.resource.data.createdAt is timestamp
        && (!('coins' in request.resource.data)
            || request.resource.data.coins is number);
    }

    function isValidUserUpdate(userId) {
      return isOwnUser(userId)
        && request.resource.data.keys().hasOnly([
          'uid', 'username', 'email', 'createdAt', 'coins'
        ])
        && request.resource.data.uid == resource.data.uid
        && request.resource.data.email == resource.data.email
        && request.resource.data.createdAt == resource.data.createdAt
        && request.resource.data.username is string
        && request.resource.data.username.size() >= 3
        && request.resource.data.username.size() <= 20
        && (!('coins' in request.resource.data)
            || request.resource.data.coins is number);
    }

    // Nur coins darf per merge aktualisiert werden (CollectionService)
    function isOwnCoinsUpdate(userId) {
      return isOwnUser(userId)
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['coins'])
        && request.resource.data.coins is number
        && request.resource.data.coins >= 0;
    }

    function isValidPublicStats() {
      return signedIn()
        && request.resource.data.keys().hasOnly([
          'uid', 'username', 'totalPoints', 'totalTokens', 'visitedLandmarks',
          'leaderboardScore', 'worldWonderTokens', 'level', 'updatedAt'
        ])
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.username is string
        && request.resource.data.totalPoints is number
        && request.resource.data.totalTokens is number
        && request.resource.data.visitedLandmarks is number
        && request.resource.data.leaderboardScore is number
        && request.resource.data.worldWonderTokens is number
        && request.resource.data.level is number;
    }

    function isValidFriendRequestCreate() {
      return signedIn()
        && request.resource.data.keys().hasOnly([
          'fromUid', 'fromUsername', 'toUid', 'toUsername', 'status', 'createdAt'
        ])
        && request.resource.data.fromUid == request.auth.uid
        && request.resource.data.fromUsername is string
        && request.resource.data.toUid is string
        && request.resource.data.toUsername is string
        && request.resource.data.status == 'pending'
        && request.resource.data.createdAt is timestamp;
    }

    function isValidFriendRequestUpdate() {
      return signedIn()
        && resource.data.keys().hasAll(['fromUid', 'toUid', 'status'])
        && request.resource.data.fromUid == resource.data.fromUid
        && request.resource.data.toUid == resource.data.toUid
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status'])
        && request.resource.data.status in ['pending', 'accepted', 'rejected']
        && (
          (request.auth.uid == resource.data.toUid && request.resource.data.status in ['accepted', 'rejected'])
          || (request.auth.uid == resource.data.fromUid && request.resource.data.status == 'pending')
        );
    }

    function isFriendRequestParticipant() {
      return signedIn()
        && (
          request.auth.uid == resource.data.fromUid
          || request.auth.uid == resource.data.toUid
        );
    }

    function isValidLeaderboardStatsWrite(userId) {
      return signedIn()
        && request.auth.uid == userId
        && request.resource.data.keys().hasOnly([
          'uid', 'username', 'photoUrl', 'totalPoints', 'totalTokens',
          'visitedLandmarks', 'leaderboardScore', 'worldWonderTokens',
          'level', 'updatedAt'
        ])
        && request.resource.data.uid == userId
        && request.resource.data.username is string
        && request.resource.data.totalPoints is number
        && request.resource.data.totalTokens is number
        && request.resource.data.visitedLandmarks is number
        && request.resource.data.leaderboardScore is number
        && request.resource.data.worldWonderTokens is number
        && request.resource.data.level is number;
    }

    function isValidFriendContactWrite(userId, friendId) {
      return signedIn()
        && request.auth.uid == userId
        && request.resource.data.keys().hasOnly(['uid', 'username', 'createdAt'])
        && request.resource.data.uid == friendId
        && request.resource.data.username is string;
    }

    function isValidUserEventTokenWrite(userId, tokenId) {
      return signedIn()
        && request.auth.uid == userId
        && request.resource.data.uid == userId
        && request.resource.data.id == tokenId
        && request.resource.data.keys().hasOnly([
          'id', 'uid', 'username', 'eventId', 'eventName', 'eventDescription',
          'startDate', 'endDate', 'landmarkId', 'landmarkName', 'tokenImageUrl',
          'markerImageUrl', 'eventStatus', 'latitude', 'longitude', 'points', 'rewardCoins', 'rewardLootboxes',
          'isActive', 'updatedAt', 'collectedAt'
        ]);
    }

    function isValidWorldWonderMirrorCreate() {
      return signedIn()
        && request.resource.data.keys().hasOnly([
          'tokenId', 'wonderId', 'serial', 'landmarkId', 'landmarkName', 'title',
          'description', 'imageUrl', 'latitude', 'longitude', 'points',
          'ownerUid', 'ownerUsername', 'claimedAt', 'status'
        ])
        && request.resource.data.ownerUid == request.auth.uid
        && request.resource.data.serial is number
        && request.resource.data.serial >= 1
        && request.resource.data.status == 'owned';
    }

    function isValidAuctionCreate() {
      return request.resource.data.keys().hasOnly([
        'sellerId', 'sellerName', 'title', 'description', 'startPrice', 'currentBid',
        'highestBidderId', 'imageUrl', 'category', 'status', 'createdAt', 'endsAt',
        'tokenData', 'tokenClaimed', 'winnerCoins'
      ])
      && request.resource.data.keys().hasAll([
        'sellerId', 'title', 'startPrice', 'currentBid', 'status', 'createdAt', 'endsAt'
      ])
      && request.resource.data.sellerId == request.auth.uid
      && request.resource.data.title is string
      && request.resource.data.title.size() > 0
      && request.resource.data.title.size() <= 100
      && (!('description' in request.resource.data)
          || request.resource.data.description is string)
      && request.resource.data.startPrice is number
      && request.resource.data.currentBid is number
      && request.resource.data.startPrice >= 0
      && request.resource.data.currentBid >= request.resource.data.startPrice
      && (!('highestBidderId' in request.resource.data)
          || request.resource.data.highestBidderId == null
          || request.resource.data.highestBidderId is string)
      && (!('imageUrl' in request.resource.data)
          || request.resource.data.imageUrl is string)
      && (!('category' in request.resource.data)
          || request.resource.data.category is string)
      && request.resource.data.status in ['active', 'ended', 'cancelled']
      && request.resource.data.createdAt is timestamp
      && request.resource.data.endsAt is timestamp
      && request.resource.data.endsAt > request.resource.data.createdAt;
    }

    function isValidAuctionUpdateBySeller() {
      return isAuctionSeller()
      && request.resource.data.sellerId == resource.data.sellerId
      && request.resource.data.createdAt == resource.data.createdAt
      && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
        'title', 'description', 'imageUrl', 'category', 'status', 'endsAt'
      ])
      && request.resource.data.title is string
      && request.resource.data.title.size() > 0
      && request.resource.data.title.size() <= 100
      && (!('description' in request.resource.data)
          || request.resource.data.description is string)
      && (!('imageUrl' in request.resource.data)
          || request.resource.data.imageUrl is string)
      && (!('category' in request.resource.data)
          || request.resource.data.category is string)
      && request.resource.data.status in ['active', 'ended', 'cancelled']
      && request.resource.data.endsAt is timestamp;
    }

    function isValidBidUpdate() {
      return signedIn()
      && resource.data.status == 'active'
      && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
        'currentBid', 'highestBidderId'
      ])
      && request.resource.data.sellerId == resource.data.sellerId
      && request.resource.data.currentBid is number
      && request.resource.data.currentBid > resource.data.currentBid
      && request.resource.data.highestBidderId == request.auth.uid
      && request.resource.data.title == resource.data.title
      && request.resource.data.startPrice == resource.data.startPrice
      && request.resource.data.createdAt == resource.data.createdAt
      && request.resource.data.endsAt == resource.data.endsAt
      && request.resource.data.status == resource.data.status;
    }

    // Verkaeufer nimmt Gebot an: setzt Gewinner + beendet Auktion
    function isValidAcceptBidUpdate() {
      return isAuctionSeller()
      && resource.data.status == 'active'
      && request.resource.data.status == 'ended'
      && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
        'status', 'winnerId', 'tokenClaimed', 'winnerCoins'
      ])
      && request.resource.data.sellerId == resource.data.sellerId
      && request.resource.data.winnerId is string
      && request.resource.data.tokenClaimed == false
      && request.resource.data.winnerCoins is number;
    }

    // Gewinner loest Token ein: setzt tokenClaimed = true
    function isValidClaimUpdate() {
      return signedIn()
      && resource.data.winnerId == request.auth.uid
      && resource.data.status == 'ended'
      && resource.data.tokenClaimed == false
      && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['tokenClaimed'])
      && request.resource.data.tokenClaimed == true;
    }

    // ─────────────────────────────────────────────────────────────
    // Users
    // ─────────────────────────────────────────────────────────────
    match /users/{userId} {
      // Username-Eindeutigkeit prüfen (nur für authentifizierte User)
      allow list: if signedIn();

      allow get: if signedIn();
      allow create: if isValidUserCreate(userId);
      // Profil-Update (username) ODER nur Coins-Update (CollectionService)
      allow update: if isValidUserUpdate(userId) || isOwnCoinsUpdate(userId);
      allow delete: if isOwnUser(userId);

      match /tokens/{tokenId} {
        allow read, write: if isOwnUser(userId);
      }

      match /weltwunder/{tokenId} {
        allow read, write: if isOwnUser(userId);
      }

      match /stats/{statId} {
        allow read: if signedIn();
        allow write: if isOwnUser(userId);
      }

      match /event_tokens/{tokenId} {
        allow read: if isOwnUser(userId);
        allow create: if isValidUserEventTokenWrite(userId, tokenId);
        allow update, delete: if false;
      }
    }

    // Public leaderboard stats
    match /public_stats/{userId} {
      allow read: if signedIn();
      allow create, update: if isValidPublicStats();
      allow delete: if isOwnUser(userId);
    }

    // Friend requests and friendships
    match /friend_requests/{requestId} {
      allow read: if isFriendRequestParticipant();
      allow create: if isValidFriendRequestCreate();
      allow update: if isValidFriendRequestUpdate();
      allow delete: if isFriendRequestParticipant();
    }

    // Confirmed friendships
    match /friends/{userId}/contacts/{friendId} {
      allow read: if isOwnUser(userId);
      allow create, update: if isValidFriendContactWrite(userId, friendId);
      allow delete: if isOwnUser(userId);
    }

    // Dedicated leaderboard stats (realtime source)
    match /leaderboard_stats/{userId} {
      allow read: if signedIn();
      allow create, update: if isValidLeaderboardStatsWrite(userId);
      allow delete: if isOwnUser(userId);
    }

    // Global event token definitions are read-only for clients.
    match /event_tokens/{tokenId} {
      allow read: if signedIn();
      allow create, update, delete: if false;
    }

    // Night Mode is prepared but currently read-only / non-playable.
    match /night_tokens/{tokenId} {
      allow read: if signedIn();
      allow create, update, delete: if false;
    }

    match /night_locations/{locationId} {
      allow read: if signedIn();
      allow create, update, delete: if false;
    }

    match /night_rewards/{rewardId} {
      allow read: if signedIn();
      allow create, update, delete: if false;
    }

    match /night_progress/{userId} {
      allow read: if isOwnUser(userId);
      allow create, update, delete: if isOwnUser(userId);
    }

    match /night_stats/{userId} {
      allow read: if isOwnUser(userId);
      allow create, update, delete: if isOwnUser(userId);
    }

    // Server-side managed event rotation config
    match /event_rotation/{docId} {
      allow read: if signedIn();
      allow write: if false;
    }

    // Global world wonder catalog and owned instances
    match /weltwunder/{wonderId} {
      allow read: if signedIn();
      allow create, update: if signedIn();
      allow delete: if false;

      match /tokens/{serialId} {
        allow read: if signedIn();
        allow create, update: if signedIn();
        allow delete: if signedIn();
      }
    }

    // Canonical world wonders collection (alias for new structure)
    match /world_wonders/{wonderId} {
      allow read: if signedIn();
      allow create, update: if signedIn();
      allow delete: if false;

      match /tokens/{serialId} {
        allow read: if signedIn();
        allow create, update: if signedIn();
        allow delete: if signedIn();
      }
    }

    // ─────────────────────────────────────────────────────────────
    // Auctions
    // ─────────────────────────────────────────────────────────────
    match /auctions/{auctionId} {
      allow read: if signedIn();
      allow create: if signedIn() && isValidAuctionCreate();
      allow update: if isValidAuctionUpdateBySeller() || isValidBidUpdate() || isValidAcceptBidUpdate() || isValidClaimUpdate();
      allow delete: if isAuctionSeller();

      // Gebote als Subcollection – jeder eingeloggte User darf lesen und eigene Gebote erstellen
      match /bids/{bidId} {
        allow read: if signedIn();
        allow create: if signedIn()
          && request.resource.data.keys().hasAll(['bidderId', 'bidderName', 'coins', 'offeredTokenIds', 'offeredTokenNames', 'createdAt'])
          && request.resource.data.bidderId == request.auth.uid
          && request.resource.data.coins is number
          && request.resource.data.coins >= 0
          && request.resource.data.createdAt is timestamp;
      }
    }

    // ─────────────────────────────────────────────────────────────
    // Feedback
    // ─────────────────────────────────────────────────────────────
    match /feedback/{feedbackId} {
      allow create: if signedIn();
      allow read, update, delete: if false;
    }

    // ─────────────────────────────────────────────────────────────
    // Alles andere verbieten
    // ─────────────────────────────────────────────────────────────
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
